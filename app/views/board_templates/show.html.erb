<nav aria-label="breadcrumb">
  <ul>
    <li><a href="/">Home</a></li>
    <li><%= @the_board.name %></li>
  </ul>
</nav>

<% active_listings = @the_board.listings.where({ :expires_on => (Date.today...) }) %>
<% expired_listings = @the_board.listings.where({ :expires_on => (...Date.today) }) %>


<article>
  <header>
    Active listings
  </header>
  <div class="overflow-auto">
    <table>
      <thead>
        <th>Title</th>
        <th>Body</th>
        <th>Expires on</th>
        <th>Posted on</th>
      </thead>
      <% active_listings.each do |listing| %>
        <tr>
          <td><%= listing.title %></td>
          <td><%= listing.body %></td>
          <td><%= listing.expires_on.strftime("%b %e, %Y") %></td>
          <td><%= listing.created_at.strftime("%b %e, %Y") %></td>
        </tr>
      <% end %>
    </table>
  </div>
</article>



<article>
  <header>
    <h2>
      Edit board
    </h2>
  </header>

  <form action="/modify_board/<%= @the_board.id %>"  method="post" >
    <div>
      <label for="name_box">
        Name
      </label>

      <input type="text" id="name_box" name="query_name" value="<%= @the_board.name %>">
    </div>

    <button type="submit">
      Update board
    </button>
  </form>
</article>

<article>
  <header>
    Expired listings
  </header>
  <div class="overflow-auto">
    <table>
      <thead>
        <th>Title</th>
        <th>Body</th>
        <th>Expired on</th>
        <th>Posted on</th>
      </thead>
      <% expired_listings.each do |listing| %>
        <tr>
          <td><%= listing.title %></td>
          <td><%= listing.body %></td>
          <td><%= listing.expires_on.strftime("%b %e, %Y") %></td>
          <td><%= listing.created_at.strftime("%b %e, %Y") %></td>
        </tr>
      <% end %>
    </table>
  </div>
</article>
