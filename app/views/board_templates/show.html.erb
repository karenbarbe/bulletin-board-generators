<nav aria-label="breadcrumb">
  <ul>
    <li><a href="/">Home</a></li>
    <li><%= @the_board.name %></li>
  </ul>
</nav>

<% active_listings = @the_board.listings.where({ :expires_on => (Date.today...) }) %>
<% expired_listings = @the_board.listings.where({ :expires_on => (...Date.today) }) %>


<article>
  <header>
    Active listings
  </header>
  <div class="overflow-auto">
    <table>
      <thead>
        <th>Title</th>
        <th>Body</th>
        <th>Expires on</th>
        <th>Posted on</th>
      </thead>
      <% active_listings.each do |listing| %>
        <tr>
          <td><%= listing.title %></td>
          <td><%= listing.body %></td>
          <td><%= listing.expires_on.strftime("%b %e, %Y") %></td>
          <td><%= listing.created_at.strftime("%b %e, %Y") %></td>
        </tr>
      <% end %>
    </table>
  </div>
</article>



<article>
  <header>

      Add a new listing

  </header>

  <form action="/insert_listing" method="post">

      <label for="title_box">
        Title
      </label>

      <input type="text" id="title_box" name="query_title">



      <label for="body_box">
        Body
      </label>

    <textarea name="query_body" id="body_box"></textarea>

      <label for="expires_on_box">
        Expires on
      </label>

      <input type="date" id="expires_on_box" name="query_expires_on">




      <input type="hidden" id="board_id_box" name="query_board_id" value="<%= @the_board.id %>">

    <button type="submit">
      Create listing
    </button>
  </form>
</article>



<article>
  <header>
    Expired listings
  </header>
  <div class="overflow-auto">
    <table>
      <thead>
        <th>Title</th>
        <th>Body</th>
        <th>Expired on</th>
        <th>Posted on</th>
      </thead>
      <% expired_listings.each do |listing| %>
        <tr>
          <td><%= listing.title %></td>
          <td><%= listing.body %></td>
          <td><%= listing.expires_on.strftime("%b %e, %Y") %></td>
          <td><%= listing.created_at.strftime("%b %e, %Y") %></td>
        </tr>
      <% end %>
    </table>
  </div>
</article>
